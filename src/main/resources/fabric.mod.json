{
    "schemaVersion" : 1,
    "id" : "kitek",
    "version" : "${version}",
    "name" : "kitek",
    "description": "Mod library that adds new way to add new content into game without creating mods",
    "authors" : ["TehnoTheDragon"],
    "contact" : {},
    "license" : "Apache-2.0",
    "icon" : "assets/kitek/icon.png",
    "environment" : "*",
    "entrypoints" : {
        "fabric-datagen" : [
            "me.tehnothedragon.kitek.KitekDataGenerator"
        ],
        "client" : [
            "me.tehnothedragon.kitek.client.KitekClient"
        ],
        "main" : [
            "me.tehnothedragon.kitek.Kitek"
        ]
    },
    "mixins" : [
        "kitek.mixins.json",
        {
            "config" : "kitek.client.mixins.json",
            "environment" : "client"
        }
    ],
    "depends" : {
        "fabricloader" : ">=${loader_version}",
        "fabric-language-kotlin" : ">=${kotlin_loader_version}",
        "fabric" : "*",
        "minecraft" : "${minecraft_version}"
    }
}
